# Backend (middleware) configuration — copy to .env and fill in.
# NEVER commit .env (it is gitignored).

# Base URL of the Research API (the decision engine). Start that service first.
RESEARCH_API_URL=http://localhost:8001

# Claude API — required for the agentic Ask AI chat (tool use is Claude-only)
ANTHROPIC_API_KEY=

# Auth token signing secret (any long random string)
JWT_SECRET=

# Optional: CORS origins (defaults to localhost:3000 and :5173)
# CORS_ORIGINS=http://localhost:5173

# Optional: database URL (defaults to local SQLite stocktrading.db)
# DATABASE_URL=sqlite:///stocktrading.db
